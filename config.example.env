# Copy this file to .env and fill in your values.

# --- Gemini (Google AI Studio) ---
GOOGLE_API_KEY=your_google_api_key_here

# --- TigerGraph Cloud ---
TG_HOST=https://<your-tg-instance>.tg-<project-id>.i.tgcloud.io
TG_GRAPH_NAME=LegalGraphRAG
TG_SECRET=your_tigergraph_secret_here
TG_SECRET_ALIAS=graphrag_secret
TG_FORCE_LOCAL=1

# --- LLM routing ---
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=xai        # optional, leave blank if unused

# --- xAI / Grok (optional fallback) ---
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.20-non-reasoning

# --- React/Node dashboard ---
PORT=8787
VITE_API_URL=http://localhost:8787
