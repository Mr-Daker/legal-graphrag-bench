FROM node:20-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-backend.txt ./
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements-backend.txt

COPY backend/package.json backend/package.json
COPY package.json package.json
RUN npm --prefix backend install --omit=dev

COPY backend backend
COPY scripts scripts
COPY data/eval data/eval
COPY data/processed data/processed
COPY data/index data/index
COPY data/tigergraph data/tigergraph
COPY data/reports data/reports
COPY vendor/tigergraph-graphrag vendor/tigergraph-graphrag

ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHON=/opt/venv/bin/python
ENV PYTHONIOENCODING=utf-8
ENV PYTHONPATH=/app/scripts
ENV LLM_PROVIDER=gemini
ENV LLM_FALLBACK_PROVIDER=
ENV TG_FORCE_LOCAL=1

EXPOSE 8080

CMD ["npm", "--prefix", "backend", "start"]
